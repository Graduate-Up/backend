# Optional environment variables. Set in the shell before starting Uvicorn.
# JOLUP_DB_PATH=data/local/accounts.sqlite3
# JOLUP_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required for school email registration. Set these in the server environment.
# JOLUP_EMAIL_CODE_SECRET=<random secret of at least 32 bytes>
# Local SMTP transport (default)
# JOLUP_EMAIL_TRANSPORT=smtp
# JOLUP_SMTP_HOST=<smtp host>
# JOLUP_SMTP_PORT=587
# JOLUP_SMTP_FROM=<verified sender email>
# JOLUP_SMTP_USERNAME=<smtp account>
# JOLUP_SMTP_PASSWORD=<smtp password or app password>
# Render Free alternative (HTTPS)
# JOLUP_EMAIL_TRANSPORT=brevo
# JOLUP_BREVO_API_KEY=<Brevo API key>
# JOLUP_BREVO_FROM=<verified Brevo sender email>
# Generative AI for course ranking and graduation chat (Gemini by default)
# JOLUP_AI_PROVIDER=gemini            # gemini | openai. Empty: Gemini if GEMINI_API_KEY is set, else OpenAI
# GEMINI_API_KEY=<Google AI Studio API key>
# JOLUP_GEMINI_MODEL=gemini-flash-latest
# Retried once when the main model returns 503/429 etc. Set empty to disable
# JOLUP_GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# OPENAI_API_KEY=<OpenAI project API key>
# JOLUP_OPENAI_MODEL=gpt-5.4-mini
# JOLUP_OPENAI_CHAT_MODEL=gpt-5.4-mini
